# ==========================================================================
# PDHRS — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ==========================================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- Database (Prisma -> PostgreSQL / Supabase) ---
# Pooled connection (use for the app runtime)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pdhrs?schema=public"
# Direct connection (use for migrations; Supabase exposes a 5432 direct URL)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pdhrs?schema=public"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- OpenAI / AI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Security ---
# 32-byte base64 key for field-level encryption of sensitive PHI columns
ENCRYPTION_KEY=base64:CHANGE_ME_32_BYTES
# Secret used to sign internal cron/job requests
CRON_SECRET=CHANGE_ME

# --- Feature flags ---
ENABLE_AI_COACH=true
ENABLE_POWERBI_EXPORT=true
